# PUBLIC_HOST vient du .env : une adresse sslip.io en attendant le vrai domaine.
# Caddy obtient et renouvelle seul le certificat HTTPS pour cette adresse.
{$PUBLIC_HOST} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /actuator/health {
		reverse_proxy api:8080
	}

	# Appli Angular : toute route inconnue renvoie index.html, le routeur Angular prend le relais.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
